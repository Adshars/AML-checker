# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
MONGO_PORT=27017
MONGO_DB_NAME=auth_db

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
POSTGRES_DB=core_db
POSTGRES_PORT=5432

# Auth Service
JWT_SECRET=<REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS>
REFRESH_TOKEN_SECRET=<REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS>
PORT_AUTH=3002

# OpenSanctions / Yente
YENTE_PORT=8000

# API Gateway
GATEWAY_PORT=8080
# SECURITY: Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Email Service
EMAIL_SERVICE=ethereal
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=<REPLACE_WITH_EMAIL_USER>
EMAIL_PASS=<REPLACE_WITH_EMAIL_PASSWORD>

# Frontend URL
FRONTEND_URL=http://localhost

# Yente (OpenSanctions)
YENTE_TITLE=Local Compliance API
YENTE_MANIFEST=/manifest.yml
YENTE_UPDATE_DATA=true

# Elasticsearch
ES_DISCOVERY_TYPE=single-node
ES_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Frontend
FRONTEND_CONTAINER_NAME=aml-checker-frontend

# Identity verification service (idv-service)
# idswyft = real OCR / liveness / face match; fake = deterministic provider without ML (E2E, low RAM)
IDV_PROVIDER=idswyft
# Encrypts stored images and verification link tokens — 64 hex chars, generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing it makes existing encrypted images unreadable
IDV_STORAGE_KEY=<REPLACE_WITH_64_HEX_CHARS>
# Optional overrides (defaults shown)
# IDV_LINK_TTL_HOURS=72
# IDV_SESSION_TTL_MINUTES=60
# IDV_IMAGE_RETENTION_DAYS=14
# IDV_MAX_DOCUMENT_ATTEMPTS=3
# IDV_MAX_SELFIE_ATTEMPTS=3
# IDV_JOBS_INTERVAL_MS=300000
# IDSWYFT_TIMEOUT_MS=90000

# Identity verification engine (self-hosted idswyft, ~3.5 GB RAM)
# Remove "idswyft" from COMPOSE_PROFILES to run without it (use IDV_PROVIDER=fake then).
COMPOSE_PROFILES=idswyft
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDSWYFT_DB_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
IDSWYFT_JWT_SECRET=<REPLACE_WITH_64_HEX_CHARS>
# WARNING: changing API_KEY_SECRET invalidates the idswyft API key
IDSWYFT_API_KEY_SECRET=<REPLACE_WITH_64_HEX_CHARS>
IDSWYFT_ENCRYPTION_KEY=<REPLACE_WITH_64_HEX_CHARS>
IDSWYFT_SERVICE_TOKEN=<REPLACE_WITH_64_HEX_CHARS>
# idswyft API is published on 127.0.0.1 only (bootstrap/probe scripts)
IDSWYFT_API_PORT=3010
# Filled in once from `npm run idv:bootstrap`
IDSWYFT_API_KEY=
